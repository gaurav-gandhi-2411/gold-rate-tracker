# ADR 060: raw third-party data is committed only as ciphertext under data/encrypted/.
# These plaintext paths are decrypted into CI workspaces and local clones and must never be
# committed again. Keep this list equal to REGISTRY in scripts/data_crypt.py (its `guard`
# subcommand fails CI if a registered path is not ignored here).
/reports/vol_regime_prereg_gcf_2000_2012.csv
/reports/vol_regime_prereg_gld_2004_2012.csv
/data/ibja_rates.parquet
/data/fusion_snapshots.parquet
/data/shadow_fusion_output.json
/data/feature_store/snapshots.parquet
/data/next_day_range_shadow.json
/data/wait_or_buy_shadow.json
/data/nowcast_shadow_log.json
/reports/derived_premium.json
/data/markup_today.json
/reports/markup_reversion/shadow.json
/reports/fhs_ranges/shadow.json
/.data_crypt_state.json
# ADR 046 option A: raw Yahoo 1-hour bars used by the premium test (E1: commit only encrypted)
/data/premium_nowcast_bars.json
# 2026-10-05 (GG decisions 1, 2, 5): own-model files that carry the raw IBJA series, and one
# retailer-derived record. Same rule as above.
/data/nextfix_oos.json
# 2026-10-08: P3 live record and ADR 071 variants carry the same raw pm0/pm1 per fold.
/data/nextfix_p3_oos.json
/data/nextfix_p3_variants_oos.json
# 2026-10-09: the decision log carries the Tanishq reading and forecast level per day.
/data/metrics_history.json
/data/nextfix_intraday_shadow.json
/data/weekly_range_shadow_log.json
/reports/tanishq_update_times/kalyan_city_identity.json
